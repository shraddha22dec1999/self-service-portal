# Copy to .env.local and fill in. All are optional for local development.

# Base URL of the gateway as the browser sees it. Leave empty to call /api on the same origin
# (the Vite dev proxy locally, nginx in the Docker image).
VITE_API_BASE=

# SSO (OpenID Connect). Leave VITE_OIDC_AUTHORITY empty for local mode, where you pick a sample
# user and the UI sends X-User. Only use local mode when the gateway runs with AUTH_ENABLED=false.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email

# Who sees the admin menu (audit, analytics, new catalogue). Comma separated.
# Stopgap until GET /api/v1/me returns roles from OPA. The backend still enforces its own rules.
VITE_ADMIN_USERS=super_admin_1,super_admin_2
